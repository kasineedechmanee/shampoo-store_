// ตั้งค่า Execute as: Me และ Who has access: Anyone (สำหรับงานสาธิต) แล้วคัดลอก URL ไปใส่ใน app.js และ admin.js
const SPREADSHEET_ID = "ใส่_GOOGLE_SHEET_ID";
function setup(){const ss=SpreadsheetApp.openById(SPREADSHEET_ID);["Products","Orders","OrderItems"].forEach(n=>{if(!ss.getSheetByName(n))ss.insertSheet(n)});const p=ss.getSheetByName("Products");if(p.getLastRow()===0)p.appendRow(["SKU","Product Name","Price","Stock"]);if(p.getLastRow()===1)p.getRange(2,1,2,4).setValues([["SH-001","แชมพูสูตรลดผมขาดหลุดร่วง",259,30],["SH-002","แชมพูสูตรดูแลหนังศีรษะ",229,25]]);const o=ss.getSheetByName("Orders");if(o.getLastRow()===0)o.appendRow(["Order ID","Created At","Customer","Phone","Address","Postcode","Note","Total","Status"]);const it=ss.getSheetByName("OrderItems");if(it.getLastRow()===0)it.appendRow(["Order ID","SKU","Product","Qty","Unit Price"])}
function doPost(e){try{const d=JSON.parse(e.postData.contents);if(d.action==="createOrder")return json(createOrder(d.order));if(d.action==="updateStatus")return json(updateStatus(d.orderId,d.status));return json({ok:false,error:"Unknown action"})}catch(err){return json({ok:false,error:String(err)})}}
function doGet(e){if(e.parameter.action==="listOrders")return json({ok:true,orders:listOrders()});return json({ok:true,message:"HAIRÉ API ready"})}
function createOrder(o){const ss=SpreadsheetApp.openById(SPREADSHEET_ID),p=ss.getSheetByName("Products"),data=p.getDataRange().getValues(),stock={};data.slice(1).forEach((r,i)=>stock[r[0]]={row:i+2,qty:Number(r[3])});(o.items||[]).forEach(x=>{if(!stock[x.sku]||stock[x.sku].qty<Number(x.qty))throw Error("สินค้าไม่เพียงพอ: "+x.sku)});const lock=LockService.getScriptLock();lock.waitLock(10000);try{(o.items||[]).forEach(x=>{const s=stock[x.sku];p.getRange(s.row,4).setValue(s.qty-Number(x.qty))});ss.getSheetByName("Orders").appendRow([o.orderId,o.createdAt,o.customer,o.phone,o.address,o.postcode,o.note,o.total,o.status]);const sh=ss.getSheetByName("OrderItems");(o.items||[]).forEach(x=>sh.appendRow([o.orderId,x.sku,x.name,x.qty,x.unitPrice]));return {ok:true,orderId:o.orderId}}finally{lock.releaseLock()}}
function listOrders(){const ss=SpreadsheetApp.openById(SPREADSHEET_ID),a=ss.getSheetByName("Orders").getDataRange().getValues(),b=ss.getSheetByName("OrderItems").getDataRange().getValues();return a.slice(1).filter(r=>r[0]).map(r=>({orderId:r[0],createdAt:r[1],customer:r[2],phone:r[3],address:r[4],postcode:r[5],note:r[6],total:r[7],status:r[8],items:b.slice(1).filter(x=>x[0]===r[0]).map(x=>({sku:x[1],name:x[2],qty:x[3],unitPrice:x[4]}))}))}
function updateStatus(id,status){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Orders"),v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++)if(v[i][0]===id){sh.getRange(i+1,9).setValue(status);return {ok:true}}return {ok:false,error:"Order not found"}}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}